# Copy this file to .env before enabling a real service. Leave credentials empty
# until they are supplied through an approved private channel.

LLM_MODE=mock
SKILL_MODE=mock
DATA_MODE=mock

LLM_PROVIDER=volcengine-ark
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_LABEL=DeepSeek V4 Pro
LLM_TEMPERATURE=0.2

DEFAULT_USERNAME=
DEFAULT_PASSWORD=
JAVA_SERVICE_BASE_URL=http://pandadata.pandaaiquant.com

QUANTSKILLS_DIR=./vendor/quantskills
PRECOMPUTED_DIR=./var/precomputed
CACHE_DIR=./var/cache
DATA_VERSION=panda-2026-07
BUILD_COMMIT=
PRECOMPUTED_COMMIT=
SKILL_TIMEOUT_SEC=120
REQUEST_BUDGET_SEC=600

HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://localhost:8080
REPOSITORY_URL=https://github.com/serein431/devils-committee
A2A_BEARER_TOKEN=
