# Copy to .env and fill in to go live. Everything defaults to a fully-offline demo.
# NOTE: comments live on their own lines (never inline after a value) so a verbatim
# `cp .env.example .env` can't accidentally fold a comment into a value.

# ---- modes: mock | (real) ----
# LLM_MODE:   mock | openai
LLM_MODE=mock
# DATA_MODE:  mock | panda
DATA_MODE=mock
# SKILL_MODE: mock | cli
SKILL_MODE=mock

# ---- LLM (OpenAI-compatible; DeepSeek key from the PandaAI Feishu group) ----
LLM_BASE_URL=https://api.deepseek.com/v1
# TODO(feishu): paste the DeepSeek API key
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.6

# ---- panda_data (TODO(feishu): creds from the group) ----
DEFAULT_USERNAME=
DEFAULT_PASSWORD=
JAVA_SERVICE_BASE_URL=

# ---- QuantSkills CLI mode (run scripts/fetch_quantskills.sh first) ----
QUANTSKILLS_DIR=./vendor/quantskills

# ---- serving / A2A ----
HOST=0.0.0.0
PORT=8080
# PUBLIC_URL: set to your Cloudflare Tunnel / VPS URL for judging
PUBLIC_URL=http://localhost:8080
# A2A_BEARER_TOKEN: set a token to require auth; empty = open (dev)
A2A_BEARER_TOKEN=
CACHE_DIR=./.cache
